# Copy this file to .env and fill in your keys. Never commit the real .env.

# Required for scraping Meta Ad Library (Apify actor "apify/facebook-ads-scraper")
# Get it from https://console.apify.com/account/integrations
APIFY_TOKEN=

# Required for transcribing ad videos (AssemblyAI)
# Get it from https://www.assemblyai.com/app/api-keys
ASSEMBLYAI_API_KEY=

# Required for hook analysis (Claude API). Without this, analyze.py writes
# a ready-to-paste prompt file instead of calling the API automatically.
ANTHROPIC_API_KEY=

# Optional override of the Apify actor id
APIFY_ACTOR_ID=apify/facebook-ads-scraper
